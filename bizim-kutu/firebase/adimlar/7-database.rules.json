            }
          },
          "rematch": {
            "$p": {
              ".validate": "($p === root.child('pinTry').child(auth.uid).child('person').val() && newData.val() === true) || newData.val() === data.val()"
            }
          },
          "here": {
            "$p": {
              ".validate": "newData.isBoolean() && ($p === root.child('pinTry').child(auth.uid).child('person').val() || newData.val() === data.val())"
            }
          },
          "state": {
            "board": {
              "$cell": {
                ".validate": "newData.parent().parent().parent().child('game').val() !== 'xox' || ($cell.matches(/^c[0-8]$/) && newData.isString() && (newData.val() === data.val() || (newData.val() === '-' && newData.parent().parent().child('moves').val() === 0) || ((!data.exists() || data.val() === '-') && data.parent().parent().child('turn').val() === root.child('pinTry').child(auth.uid).child('person').val() && newData.val() === data.parent().parent().child('marks').child(root.child('pinTry').child(auth.uid).child('person').val()).val() && newData.parent().parent().child('moves').val() === data.parent().parent().child('moves').val() + 1)))"
              }
            },
            "turn": {
              ".validate": "newData.parent().parent().child('players').child(newData.val()).val() === true && (newData.parent().parent().child('game').val() !== 'xox' || !data.exists() || newData.val() === data.val() || data.val() === root.child('pinTry').child(auth.uid).child('person').val() || newData.parent().child('moves').val() === 0)"
            },
            "moves": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.parent().parent().child('game').val() !== 'xox' || !data.exists() || newData.val() === 0 || newData.val() === data.val() || newData.val() === data.val() + 1)"
            },
            "marks": {
              "$p": {
                ".validate": "(newData.val() === 'X' || newData.val() === 'O') && (!data.exists() || data.val() === newData.val())"
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "scores": {

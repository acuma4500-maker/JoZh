            ".validate": "(newData.val() === 'pt0Kmbc9rqdJekFyvA1wLItUnxw1' || newData.val() === 'cf6RqCRF6dPEWtSR1L9Dm2Uv4Ap1') && (!data.exists() || data.val() === newData.val())"
          },

          ".validate": "newData.hasChildren(['from', 'to', 'game', 'status', 'createdAt'])",
          "from": {
            ".validate": "(!data.exists() && newData.val() === root.child('pinTry').child(auth.uid).child('person').val()) || data.val() === newData.val()"
          },

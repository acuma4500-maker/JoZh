          "$key": {
            ".write": "auth != null && (root.child('pinTry').child(auth.uid).child('pin').val() === root.child('secrets').child('pins').child(root.child('pinTry').child(auth.uid).child('person').val()).val() || root.child('pinTry').child(auth.uid).child('pinText').val() === root.child('secrets').child('pins').child(root.child('pinTry').child(auth.uid).child('person').val()).val())",
            ".validate": "$game.matches(/^(xox|know-me|truth-dare|emoji|memory|story|questions)$/) && (($key === 'pt0Kmbc9rqdJekFyvA1wLItUnxw1' || $key === 'cf6RqCRF6dPEWtSR1L9Dm2Uv4Ap1') || $key === 'draw') && newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
          }
        }

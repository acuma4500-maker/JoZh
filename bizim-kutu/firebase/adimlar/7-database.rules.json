            ".validate": "(newData.val() === 'pt0Kmbc9rqdJekFyvA1wLItUnxw1' || newData.val() === 'cf6RqCRF6dPEWtSR1L9Dm2Uv4Ap1') && newData.val() !== newData.parent().child('from').val() && (!data.exists() || data.val() === newData.val())"
          },
          "game": {
            ".validate": "newData.isString() && newData.val().matches(/^(xox|know-me|truth-dare|emoji|memory|story|questions)$/) && (!data.exists() || data.val() === newData.val())"
          },
          "status": {
            ".validate": "(!data.exists() && newData.val() === 'pending') || (data.exists() && newData.val() === data.val()) || (data.val() === 'pending' && (((newData.val() === 'accepted' || newData.val() === 'declined') && newData.parent().child('to').val() === root.child('pinTry').child(auth.uid).child('person').val()) || (newData.val() === 'cancelled' && newData.parent().child('from').val() === root.child('pinTry').child(auth.uid).child('person').val())))"
          },
          "createdAt": {
            ".validate": "(!data.exists() && newData.val() === now) || (data.exists() && data.val() === newData.val())"
          },
          "respondedAt": {
            ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
          },
